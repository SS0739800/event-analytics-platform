# Keep the build context small and, more importantly, keep secrets and local
# artefacts out of the image.
.env
.env.*
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

.git/
.github/
.gitignore

# Rebuilt inside the image by the frontend stage.
frontend/node_modules/
frontend/dist/

output/
tests/
README.md
start.bat
start.py
